# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project (Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL="MY_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
# Service role key — server-only, bypasses RLS. Used by /api/track and the
# dashboard's Leads section to read/write the `leads` table. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# --- Internal /dashboard route (marketing/ops metrics) ---
# HTTP Basic Auth credentials gating /dashboard and /api/dashboard/*.
# Leave unset and the route returns 503 (safer default than an unlocked page).
DASHBOARD_USER="MY_DASHBOARD_USERNAME"
DASHBOARD_PASSWORD="MY_DASHBOARD_PASSWORD"

# Stripe: Developers -> API keys -> Secret key (use a Restricted key with
# read-only access to Charges, Customers, Subscriptions if possible).
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"

# Go High Level: Settings -> Private Integrations -> create one with
# contacts.readonly + opportunities.readonly scopes. Location ID is in
# Settings -> Business Info (or the URL when viewing the sub-account).
# Below are three separate GHL sub-accounts feeding three separate lead
# funnels on the dashboard: this one is Apex Applications' own GHL (leads
# captured via Facebook ads), PRIMEWELL is PrimeWell's GHL, and ASH is
# Amazon Success Hub's GHL.
GHL_PRIVATE_INTEGRATION_TOKEN="MY_GHL_PRIVATE_INTEGRATION_TOKEN"
GHL_LOCATION_ID="MY_GHL_LOCATION_ID"
GHL_PRIMEWELL_PRIVATE_INTEGRATION_TOKEN="MY_GHL_PRIMEWELL_PRIVATE_INTEGRATION_TOKEN"
GHL_PRIMEWELL_LOCATION_ID="MY_GHL_PRIMEWELL_LOCATION_ID"
GHL_ASH_PRIVATE_INTEGRATION_TOKEN="MY_GHL_ASH_PRIVATE_INTEGRATION_TOKEN"
GHL_ASH_LOCATION_ID="MY_GHL_ASH_LOCATION_ID"

# Mailchimp: Account -> Extras -> API keys -> Create A Key.
# The datacenter suffix (e.g. "us21") is the part after the last "-" in the key.
MAILCHIMP_API_KEY="MY_MAILCHIMP_API_KEY-us21"

# Meta Marketing API: developers.facebook.com -> your app -> generate a
# long-lived System User access token with ads_read permission on the ad
# account below. Ad account ID is the number after "act_" in Ads Manager.
META_ACCESS_TOKEN="MY_META_ACCESS_TOKEN"
META_AD_ACCOUNT_ID="MY_META_AD_ACCOUNT_ID"

# OpenAI (ChatGPT Ads) Conversions API — server-side backup for the client
# oaiq pixel so trial_started events aren't lost to ad blockers. Used by
# /api/oaiq-conversion. Pixel ID is hardcoded (8iBamdbpfEKYXHWyzY5p8i);
# only the Bearer API key is a secret.
OAIQ_API_KEY="MY_OAIQ_API_KEY"
